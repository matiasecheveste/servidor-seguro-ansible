# {{ ansible_managed }}
# Servidor seguro con Ansible — Matías Nicolás Echeveste Cardozo
[DEFAULT]
bantime = {{ fail2ban_tiempo_bloqueo }}
bantime.increment = true
findtime = {{ fail2ban_ventana }}
maxretry = {{ fail2ban_max_intentos }}
ignoreip = {{ fail2ban_ignorar_ips | join(' ') }}
backend = systemd
banaction = ufw

[sshd]
enabled = true
mode = aggressive

[nginx-limit-req]
enabled = true
backend = auto
logpath = /var/log/nginx/error.log
